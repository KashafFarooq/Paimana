    {
      "name": "Paimana (Android emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:4000/api/v1"
      ]
    }
  ]
}
