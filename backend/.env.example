NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/paimana?appName=Cluster0
JWT_ACCESS_SECRET=replace-with-a-random-string-of-32-or-more-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-or-more-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CLIENT_ORIGIN=*
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash